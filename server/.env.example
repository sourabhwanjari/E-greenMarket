# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local URI (Leave empty to use automatic embedded MongoDB memory instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/green_grocery?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
